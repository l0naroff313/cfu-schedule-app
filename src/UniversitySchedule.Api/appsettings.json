{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=cfu_schedule;Username=cfu_schedule"
  },
  "InstallationAuthentication": {
    "Issuer": "UniversitySchedule.Api",
    "Audience": "UniversitySchedule.Mobile",
    "AccessTokenMinutes": 15
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "OpenApi": {
    "Enabled": false
  },
  "CfuSchedule": {
    "FreshCacheMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "https://l0naroff313.github.io"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
