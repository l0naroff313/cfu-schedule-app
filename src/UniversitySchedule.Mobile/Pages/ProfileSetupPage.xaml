<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversitySchedule.Mobile.Pages.ProfileSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:profiles="clr-namespace:UniversitySchedule.Mobile.Core.Profiles;assembly=UniversitySchedule.Mobile.Core"
    x:DataType="profiles:ProfileSetupViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Title="Учебный профиль">
    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,36" Spacing="16">
            <Label Style="{StaticResource PageTitle}" Text="Настройте расписание" />
            <Label
                Style="{StaticResource SecondaryText}"
                Text="Выберите данные из актуального каталога КФУ. Вход и регистрация не нужны." />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />
            <Label Style="{StaticResource SecondaryText}" Text="{Binding StatusText}" />
            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label
                        VerticalTextAlignment="Center"
                        Text="{Binding ErrorText}"
                        TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                    <Button
                        Grid.Column="1"
                        SemanticProperties.Description="Повторить загрузку каталога"
                        Clicked="OnRetryClicked"
                        Style="{StaticResource RetryIconButton}"
                        Text="↻" />
                </Grid>
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="Институт или факультет" />
            <Border Style="{StaticResource Card}">
                <Picker
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding Institutes}"
                    SelectedItem="{Binding SelectedInstitute}"
                    Title="Выберите подразделение" />
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="Направление" />
            <Border Style="{StaticResource Card}">
                <Picker
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding Directions}"
                    SelectedItem="{Binding SelectedDirection}"
                    Title="Выберите направление" />
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="Курс" />
            <Border Style="{StaticResource Card}">
                <Picker
                    ItemsSource="{Binding Courses}"
                    SelectedItem="{Binding SelectedCourse}"
                    Title="Выберите курс" />
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="Группа" />
            <Border Style="{StaticResource Card}">
                <Picker
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup}"
                    Title="Выберите номер группы" />
            </Border>

            <VerticalStackLayout IsVisible="{Binding Electives.IsEligible}" Spacing="12">
                <Label Style="{StaticResource SectionTitle}" Text="Элективы ЦК и ДРПК" />
                <Button Text="Выбрать / обновить группу ЦК или ДРПК" Clicked="OnElectivesClicked" />
                <ActivityIndicator IsRunning="{Binding Electives.IsBusy}" IsVisible="{Binding Electives.IsBusy}" />
                <Label Style="{StaticResource SecondaryText}" Text="{Binding Electives.Status}" />
                <Border Style="{StaticResource Card}">
                    <Picker Title="Элективная дисциплина" ItemsSource="{Binding Electives.Disciplines}" SelectedItem="{Binding Electives.Discipline}" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <Picker Title="Группа ЦК / ДРПК" ItemsSource="{Binding Electives.Groups}" SelectedItem="{Binding Electives.Group}" />
                </Border>
                <VerticalStackLayout IsVisible="{Binding Electives.HasModules}" Spacing="8">
                    <Label Style="{StaticResource SecondaryText}" Text="КФУ не указал даты модулей. Выберите текущий модуль; он применяется к отображаемым неделям до ручного переключения." />
                    <Picker Title="Текущий модуль" ItemsSource="{Binding Electives.Modules}" SelectedItem="{Binding Electives.Module}" />
                </VerticalStackLayout>
                <Button Text="Не добавлять электив" Clicked="OnClearElectiveClicked" />
            </VerticalStackLayout>

            <Label Style="{StaticResource SectionTitle}" Text="Подгруппа" />
            <Border Style="{StaticResource Card}">
                <Picker
                    ItemsSource="{Binding Subgroups}"
                    SelectedItem="{Binding SelectedSubgroup}"
                    Title="Выберите подгруппу" />
            </Border>

            <Button
                Clicked="OnSaveClicked"
                IsEnabled="{Binding CanSave}"
                Text="Сохранить и открыть расписание" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
