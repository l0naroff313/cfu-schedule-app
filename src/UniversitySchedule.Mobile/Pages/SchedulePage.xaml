<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversitySchedule.Mobile.Pages.SchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UniversitySchedule.Mobile.Core.Scheduling;assembly=UniversitySchedule.Mobile.Core"
    x:DataType="viewModels:SchedulePageViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False"
    Title="Расписание">
    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,32" Spacing="16">
            <Label Style="{StaticResource PageTitle}" Text="Расписание" />

            <Border Style="{StaticResource SegmentTrack}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button
                        Grid.Column="0"
                        Command="{Binding SelectGroupCommand}"
                        Style="{StaticResource SegmentButton}"
                        Text="Моя группа">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsGroupMode}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Command="{Binding SelectTeacherCommand}"
                        Style="{StaticResource SegmentButton}"
                        Text="Преподаватель">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsTeacherMode}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <VerticalStackLayout
                IsVisible="{Binding IsTeacherMode}"
                Spacing="12">
                <Label Style="{StaticResource SectionTitle}" Text="Выбор преподавателя" />
                <Border Padding="0" Style="{StaticResource InputBorder}">
                    <SearchBar
                        Placeholder="Найти преподавателя"
                        SearchButtonPressed="OnTeacherSearchButtonPressed"
                        SemanticProperties.Description="Поиск преподавателя"
                        Text="{Binding TeacherQuery}" />
                </Border>
                <Label Style="{StaticResource SecondaryText}" Text="{Binding TeacherCatalogSummaryText}" />
                <Border
                    IsVisible="{Binding HasTeacherOptions}"
                    Style="{StaticResource Card}">
                    <Picker
                        ItemsSource="{Binding TeacherOptions}"
                        SelectedItem="{Binding SelectedTeacher}"
                        Title="Выберите преподавателя" />
                </Border>
                <Label
                    IsVisible="{Binding HasNoTeacherOptions}"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding TeacherEmptyText}" />

                <Border
                    IsVisible="{Binding HasSelectedTeacher}"
                    Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource SectionTitle}" Text="{Binding SelectedTeacherProfile.FullName}" />
                        <Label Style="{StaticResource SecondaryText}" Text="{Binding SelectedTeacherProfile.PositionText}" />
                        <BoxView
                            HeightRequest="1"
                            Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                        <Label Style="{StaticResource SecondaryText}" Text="{Binding TeacherDetailLabel}" />
                        <Label Style="{StaticResource SectionTitle}" Text="{Binding TeacherStatusTitle}" />
                        <Label
                            Text="{Binding TeacherLocationText}" />
                        <Label
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding TeacherSubjectText}" />

                        <VerticalStackLayout
                            IsVisible="{Binding SelectedTeacherProfile.HasDisciplines}"
                            Spacing="6">
                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                            <Label Style="{StaticResource SectionTitle}" Text="Преподаваемые дисциплины" />
                            <Label LineBreakMode="WordWrap" Text="{Binding SelectedTeacherProfile.DisciplinesText}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            IsVisible="{Binding SelectedTeacherProfile.HasSpecialties}"
                            Spacing="6">
                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                            <Label Style="{StaticResource SectionTitle}" Text="Специальности" />
                            <Label LineBreakMode="WordWrap" Text="{Binding SelectedTeacherProfile.SpecialtiesText}" />
                        </VerticalStackLayout>

                        <Label
                            IsVisible="{Binding SelectedTeacherProfile.HasNoAcademicDetails}"
                            Style="{StaticResource SecondaryText}"
                            Text="Дополнительные сведения отсутствуют в справочнике." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource SegmentTrack}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button
                        Grid.Column="0"
                        Command="{Binding SelectDayCommand}"
                        Style="{StaticResource SegmentButton}"
                        Text="День">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsDayMode}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Command="{Binding SelectWeekCommand}"
                        Style="{StaticResource SegmentButton}"
                        Text="Неделя">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsWeekMode}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                <Button
                    Command="{Binding PreviousPeriodCommand}"
                    SemanticProperties.Description="Предыдущий период"
                    Style="{StaticResource IconButton}"
                    Text="‹" />
                <Grid Grid.Column="1">
                    <Border
                        Padding="8,4"
                        InputTransparent="True"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="{Binding PeriodText}"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource SecondaryText}"
                                Text="⌄"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <DatePicker
                        Date="{Binding SelectedDateValue, Mode=TwoWay}"
                        HorizontalOptions="Fill"
                        Opacity="0.01"
                        SemanticProperties.Description="Выбрать дату"
                        VerticalOptions="Fill" />
                </Grid>
                <Button
                    Grid.Column="2"
                    Command="{Binding GoTodayCommand}"
                    FontSize="12"
                    HeightRequest="40"
                    Padding="10,6"
                    Style="{StaticResource SegmentButton}"
                    Text="Сегодня" />
                <Button
                    Grid.Column="3"
                    Command="{Binding NextPeriodCommand}"
                    SemanticProperties.Description="Следующий период"
                    Style="{StaticResource IconButton}"
                    Text="›" />
            </Grid>

            <CollectionView
                HeightRequest="64"
                HorizontalScrollBarVisibility="Never"
                ItemsSource="{Binding WeekDates}"
                ItemsLayout="HorizontalList"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ScheduleDateItem">
                        <Border
                            Margin="2,0"
                            Padding="6,7"
                            BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnDateTapped" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="1">
                                <Label HorizontalTextAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding DayText}">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label HorizontalTextAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding DateText}">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <HorizontalStackLayout Spacing="8">
                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}" />
                <Label Style="{StaticResource SecondaryText}" Text="{Binding SyncStatusText}" />
            </HorizontalStackLayout>

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Lessons}"
                IsVisible="{Binding HasLessons}"
                Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ScheduleLessonListItem">
                        <Border Style="{StaticResource Card}">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" TargetType="Border" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandPrimaryLight}, Dark={StaticResource BrandPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Tapped="OnLessonTapped" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="14"
                                RowDefinitions="Auto,Auto,Auto,Auto">
                                <Border
                                    Grid.RowSpan="4"
                                    Padding="10,8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SegmentTrackLight}, Dark={StaticResource SegmentTrackDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource SectionTitle}"
                                            Text="{Binding PairText}" />
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding TimeText}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryText}"
                                    Text="{Binding DateText}" />
                                <Button
                                    Grid.Column="2"
                                    Grid.RowSpan="2"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnLessonActionClicked"
                                    SemanticProperties.Description="Действия с занятием"
                                    Style="{StaticResource IconButton}"
                                    Text="⋯" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{Binding Subject}" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryText}"
                                    Text="{Binding Details}" />
                                <VerticalStackLayout
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="2">
                                    <Label Text="{Binding Location}" />
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding Teachers}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border
                IsVisible="{Binding HasNoLessons}"
                Style="{StaticResource Card}">
                <Label Style="{StaticResource SecondaryText}" Text="{Binding ScheduleEmptyText}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
