<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversitySchedule.Mobile.Pages.AssignmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Title="Задания">
    <VerticalStackLayout Padding="16,24" Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                Style="{StaticResource PageTitle}"
                Text="Задания"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                IsEnabled="False"
                SemanticProperties.Description="Добавить задание; станет доступно после настройки профиля"
                Style="{StaticResource CompactAddButton}"
                Text="+" />
        </Grid>
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource SecondaryText}" Text="Здесь будут храниться личные домашние задания и дедлайны." />
                <Label Style="{StaticResource SecondaryText}" Text="Добавление станет доступно после выбора учебного профиля." />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
